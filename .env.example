# 复制为 .env 后填写。以下三项没有默认值，缺少任意一项时 docker compose / 后端都会直接启动失败。
COMPOSE_PROJECT_NAME=ai-learning-assistant

# MySQL root 密码（后端也用它连接数据库）
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=ai_learning_assistant
MYSQL_HOST_PORT=3307

# JWT 签名密钥，至少 32 个字符。可用下面命令生成：
#   openssl rand -base64 48
APP_JWT_SECRET=

# 可选：AI 服务配置（未填写时默认走 Mock 模式）
APP_AI_MOCK_MODE=true
APP_AI_API_KEY=
APP_AI_BASE_URL=https://api.openai.com
APP_AI_DEFAULT_MODEL=gpt-4o-mini
