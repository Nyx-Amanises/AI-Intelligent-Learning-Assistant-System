# 复制为 .env 后按需填写。
# 本地开发模式下开箱即用：未配置时 MySQL 密码默认 123456789，JWT 密钥在内存中随机生成，
# 加密口令自动生成并落入 runtime/ 目录跨重启复用。
# 生产环境（prod profile）启动前会进行严格校验，必须显式提供以下敏感配置：
COMPOSE_PROJECT_NAME=ai-learning-assistant

# MySQL root 密码（生产环境必填，本地未填时默认 123456789）
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=ai_learning_assistant
MYSQL_HOST_PORT=3307

# JWT 签名密钥（生产环境必填，至少 32 个字符。本地未填时在内存中随机生成，重启后旧 Token 失效）
# 可用命令生成：openssl rand -base64 48
APP_JWT_SECRET=

# 数据库中 AI 配置 API Key 的加密口令（生产环境必填，至少 16 个字符；AES-256-GCM）
# 本地未填时自动生成并保存到 runtime/secret-encryption.key 跨重启复用
# 可用命令生成：openssl rand -base64 32
APP_SECRET_ENCRYPTION_KEY=

# 可选：AI 服务配置（未填写时默认走 Mock 模式）
APP_AI_MOCK_MODE=true
APP_AI_API_KEY=
APP_AI_BASE_URL=https://api.openai.com
APP_AI_DEFAULT_MODEL=gpt-4o-mini
